# Database (Generic/Docker)
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=password
DB_USER=woolet_app
DB_PASSWORD=password
DB_NAME=woolet
DB_PORT=5433
DB_MAX_CONNECTIONS=2


# Clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Paddle Billing
# Use sandbox values during development, then switch to production tokens/price IDs.
VITE_PADDLE_CLIENT_TOKEN=test_xxx
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_PRO_PRICE_ID=pri_xxx
VITE_PADDLE_PREMIUM_PRICE_ID=pri_xxx
VITE_PADDLE_PRO_PRICE_LABEL=Localized at checkout
VITE_PADDLE_PREMIUM_PRICE_LABEL=Localized at checkout
PADDLE_PRO_PRICE_ID=pri_xxx
PADDLE_PREMIUM_PRICE_ID=pri_xxx
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_xxx
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_xxx

# Redis (Docker)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=password

# Docker Images (for production)
WOOLET_API_IMAGE=ghcr.io/username/repo/api:latest
WOOLET_WEB_IMAGE=ghcr.io/username/repo/web:latest
WOOLET_LANDING_IMAGE=ghcr.io/username/repo/landing:latest

# App
NODE_ENV=development
API_IDLE_TIMEOUT=60
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Production reminder:
# - Set WEB_URL to your HTTPS domain (e.g. https://woolet.academy-ai.kz)
# - Use Clerk live keys on production domains (pk_live_... / sk_live_...)

# PostHog
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
VITE_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
VITE_PUBLIC_POSTHOG_ACQUISITION_SURVEY_ID=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Logging
LOG_LEVEL=info

# AI Providers (optional)
# Provider order fallback for legacy configs: alemai,deepseek,openrouter,groq,openai,gemini
AI_PROVIDER_ORDER=alemai,deepseek,openrouter,groq,openai,gemini

# Admin-managed provider credential encryption (required before saving API keys)
# Generate a 32-byte key with: openssl rand -base64 32
# Development/single-key setup:
AI_SECRETS_MASTER_KEY=
# Production/rotation setup (JSON keyring; keep old keys until all records are rewrapped):
# Example: {"v1":"base64-32-byte-key","v2":"base64-32-byte-key"}
AI_SECRETS_MASTER_KEYS=
AI_SECRETS_ACTIVE_MASTER_KEY_ID=v1

# Alem AI (OpenAI-compatible)
ALEM_AI_QWEN3_6=
ALEM_AI_GEMMA4=
ALEM_AI_ENDPOINT=https://llm.alem.ai/v1/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
ALEM_AI_CHAT_MODEL=qwen3-6

# AI chat attachment storage (S3/MinIO-compatible)
# Stores uploaded receipt/check content for retention/audit. Values are optional;
# if not configured, chat still works but attachments are not persisted.
AI_ATTACHMENT_S3_ENDPOINT=
# Optional comma-separated failover endpoints:
# AI_ATTACHMENT_S3_ENDPOINT=https://primary.example.com,https://secondary.example.com
AI_ATTACHMENT_S3_ACCESS_KEY_ID=
AI_ATTACHMENT_S3_SECRET_ACCESS_KEY=
AI_ATTACHMENT_S3_BUCKET=woolet
AI_ATTACHMENT_S3_REGION=us-east-1
AI_ATTACHMENT_RETENTION_DAYS=365

# OpenRouter (OpenAI-compatible)
OPEN_ROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=upstage/solar-pro-3:free
# Optional but recommended by OpenRouter
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Woolet

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Other API Keys
CURRENCY_API_KEY=
GROQ_API_KEY=
TWELVE_DATA=

# Push Notifications (VAPID)
# Generate with: cd apps/api && bun run vapid-gen
VAPID_SUBJECT=mailto:woolet.app@gmail.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMTP Email Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Woolet
ENABLE_SMTP_NOTIFICATIONS=false
