---
import FeatureGrid from './react/FeatureGrid';
import { StaggeredChildren, FadeIn } from './react';

const features = [
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
    </svg>`,
    title: 'Multi-Currency Accounts',
    description: 'Manage multiple bank accounts across 170+ currencies in one place.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z" />
    </svg>`,
    title: 'Expense Tracking',
    description: 'Categorize your spending and see where your money goes each month.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>`,
    title: 'Debt Management',
    description: 'Track money you owe or are owed, with repayment history and reminders.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>`,
    title: 'Subscriptions',
    description: 'Keep track of all your recurring payments and never miss a renewal.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
    </svg>`,
    title: 'Credit Cards',
    description: 'Monitor credit limits, balances, and payment due dates.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
    </svg>`,
    title: 'Mortgages',
    description: 'Track mortgage payments, remaining balance, and interest rates.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
    </svg>`,
    title: 'Deposits & Savings',
    description: 'Monitor your savings accounts and deposit maturity dates.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
    </svg>`,
    title: 'Investments',
    description: 'Track your portfolio performance with real-time stock prices.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
    </svg>`,
    title: 'Analytics Dashboard',
    description: 'Reports and widgets that show trends across all your accounts.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
    </svg>`,
    title: 'Woo AI Assistant',
    description: 'Ask questions about your spending and balances in plain language.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
    </svg>`,
    title: 'No Bank Connection',
    description: 'You enter data manually, so your banking credentials are never shared.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
    </svg>`,
    title: 'Fast & Responsive',
    description: 'Optimized for all devices with instant sync across platforms.',
  },
];

const tags = ['Multi-currency', 'Reports & Analytics', 'Data Export', 'Custom Categories', 'Goals Tracking', 'Recurring Transactions'];
---

<section id="features" class="relative py-24 sm:py-32 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 dot-pattern opacity-30"></div>
  </div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <StaggeredChildren client:visible>
      <div class="text-center mb-16 sm:mb-20">
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 feature-title">
          Every account, debt, and investment
          <span class="block bg-clip-text text-transparent bg-gradient-to-r from-white/90 to-white/60">in one place</span>
        </h2>
        
        <p class="text-lg text-slate-400 max-w-2xl mx-auto feature-subtitle">
          Woolet covers the accounts most trackers skip — mortgages, deposits, credit cards — with multi-currency support built in.
        </p>
      </div>
    </StaggeredChildren>
    
    <!-- Features Grid with React -->
    <FeatureGrid features={features} client:visible />
    
    <!-- Bottom tags -->
    <FadeIn delay={0.4} client:visible>
      <div class="mt-16 text-center feature-tags">
        <p class="text-slate-400 mb-6">
          Also included:
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          {tags.map((tag, i) => (
            <span 
              class="tag-item px-4 py-2 rounded-full glass text-sm text-slate-300 border border-white/10 hover:border-white/25 hover:bg-white/5 transition-all duration-300 cursor-default"
              style={`--tag-delay: ${i * 0.05}s`}
            >
              {tag}
            </span>
          ))}
        </div>
      </div>
    </FadeIn>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .feature-title,
  .feature-subtitle,
  .feature-tags {
    animation: fadeInUp 0.6s ease-out both;
  }

  .feature-title { animation-delay: 0.2s; }
  .feature-subtitle { animation-delay: 0.3s; }
  .feature-tags { animation-delay: 0.5s; }

  .tag-item {
    animation: fadeInUp 0.4s ease-out both;
    animation-delay: calc(0.6s + var(--tag-delay));
  }
</style>
