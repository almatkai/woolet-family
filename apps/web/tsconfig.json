{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "baseUrl": ".",
        "skipLibCheck": true,
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "react": [
                "./node_modules/@types/react"
            ],
            "react/jsx-runtime": [
                "./node_modules/@types/react/jsx-runtime"
            ],
            "react-dom": [
                "./node_modules/@types/react-dom"
            ]
        }
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules"
    ]
}