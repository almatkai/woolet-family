":"276","messageId":"277","endLine":61,"endColumn":293,"fix":"281"},{"ruleId":"274","severity":1,"message":"275","line":61,"column":380,"nodeType":"276","messageId":"277","endLine":61,"endColumn":403,"fix":"282"},{"ruleId":"274","severity":1,"message":"275","line":16,"column":12,"nodeType":"276","messageId":"277","endLine":16,"endColumn":98,"fix":"283"},{"ruleId":"274","severity":1,"message":"275","line":54,"column":38,"nodeType":"276","messageId":"277","endLine":54,"endColumn":67,"fix":"284"},{"ruleId":"274","severity":1,"message":"275","line":66,"column":49,"nodeType":"276","messageId":"277","endLine":66,"endColumn":87,"fix":"285"},{"ruleId":"286","severity":1,"message":"287","line":3,"column":21,"nodeType":"288","messageId":"289","endLine":3,"endColumn":28,"suggestions":"290"},{"ruleId":"291","severity":2,"message":"292","line":52,"column":5,"nodeType":null,"endLine":52,"endColumn":14},{"ruleId":"291","severity":2,"message":"293","line":60,"column":43,"nodeType":null,"endLine":60,"endColumn":51},{"ruleId":"294","severity":2,"message":"295","line":359,"column":29,"nodeType":null,"endLine":359,"endColumn":72},{"ruleId":"294","severity":2,"message":"296","line":359,"column":40,"nodeType":null,"endLine":359,"endColumn":71},{"ruleId":"294","severity":2,"message":"297","line":359,"column":52,"nodeType":null,"endLine":359,"endColumn":71},{"ruleId":"294","severity":2,"message":"298","line":359,"column":53,"nodeType":null,"endLine":359,"endColumn":71},{"ruleId":"294","severity":2,"message":"299","line":374,"column":19,"nodeType":null,"endLine":374,"endColumn":36},{"ruleId":"294","severity":2,"message":"299","line":374,"column":19,"nodeType":null,"endLine":374,"endColumn":36},{"ruleId":"294","severity":2,"message":"300","line":375,"column":22,"nodeType":null,"endLine":375,"endColumn":39},{"ruleId":"294","severity":2,"message":"300","line":375,"column":22,"nodeType":null,"endLine":375,"endColumn":39},{"ruleId":"274","severity":1,"message":"275","line":47,"column":48,"nodeType":"276","messageId":"277","endLine":47,"endColumn":65,"fix":"301"},{"ruleId":"274","severity":1,"message":"275","line":124,"column":16,"nodeType":"276","messageId":"277","endLine":124,"endColumn":43,"fix":"302"},{"ruleId":"291","severity":2,"message":"303","line":49,"column":5,"nodeType":null,"endLine":49,"endColumn":14},"@typescript-eslint/array-type","Array type using 'Array<T>' is forbidden. Use 'T[]' instead.","TSTypeReference","errorStringArray",{"range":"304","text":"305"},{"range":"306","text":"307"},{"range":"308","text":"309"},{"range":"310","text":"311"},{"range":"312","text":"313"},{"range":"314","text":"315"},{"range":"316","text":"317"},{"range":"318","text":"319"},"@typescript-eslint/no-unused-vars","'useMemo' is defined but never used.","Identifier","unusedVar",["320"],"react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/almatkairatov/Desktop/code/woolet/apps/mobile-v2/src/app/(app)/investment-trade.tsx:52:5\n  50 |   useEffect(() => {\n  51 |     if (!selectedStock) return;\n> 52 |     setTicker(selectedStock.ticker);\n     |     ^^^^^^^^^ Avoid calling setState() directly within an effect\n  53 |     setName(selectedStock.name);\n  54 |     setCurrency(selectedStock.currency);\n  55 |     setExchange(selectedStock.exchange ?? '');","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/almatkairatov/Desktop/code/woolet/apps/mobile-v2/src/app/(app)/investment-trade.tsx:60:43\n  58 |\n  59 |   useEffect(() => {\n> 60 |     if (!price && quoteQuery.data?.price) setPrice(String(quoteQuery.data.price));\n     |                                           ^^^^^^^^ Avoid calling setState() directly within an effect\n  61 |   }, [price, quoteQuery.data?.price]);\n  62 |\n  63 |   const invalidate = async () => Promise.all([","react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/almatkairatov/Desktop/code/woolet/apps/mobile-v2/src/components/accounts/wallet-bank-card.tsx:359:29\n  357 |   // Raised (above the pocket) only from mid-lift until mid-return — or if we\n  358 |   // mounted directly into the active state without an animation.\n> 359 |   const effectivelyRaised = raised || (isActive && !didAnimate.current);\n      |                             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  360 |\n  361 |   return (\n  362 |     <AnimatedPressable","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/almatkairatov/Desktop/code/woolet/apps/mobile-v2/src/components/accounts/wallet-bank-card.tsx:359:40\n  357 |   // Raised (above the pocket) only from mid-lift until mid-return — or if we\n  358 |   // mounted directly into the active state without an animation.\n> 359 |   const effectivelyRaised = raised || (isActive && !didAnimate.current);\n      |                                        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  360 |\n  361 |   return (\n  362 |     <AnimatedPressable","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/almatkairatov/Desktop/code/woolet/apps/mobile-v2/src/components/accounts/wallet-bank-card.tsx:359:52\n  357 |   // Raised (above the pocket) only from mid-lift until mid-return — or if we\n  358 |   // mounted directly into the active state without an animation.\n> 359 |   const effectivelyRaised = raised || (isActive && !didAnimate.current);\n      |                                                    ^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  360 |\n  361 |   return (\n  362 |     <AnimatedPressable","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/almatkairatov/Desktop/code/woolet/apps/mobile-v2/src/components/accounts/wallet-bank-card.tsx:359:53\n  357 |   // Raised (above the pocket) only from mid-lift until mid-return — or if we\n  358 |   // mounted directly into the active state without an animation.\n> 359 |   const effectivelyRaised = raised || (isActive && !didAnimate.current);\n      |                                                     ^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  360 |\n  361 |   return (\n  362 |     <AnimatedPressable\n\nTo initialize a ref only once, check that the ref is null with the pattern `if (ref.current == null) { ref.current = ... }`","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/almatkairatov/Desktop/code/woolet/apps/mobile-v2/src/components/accounts/wallet-bank-card.tsx:374:19\n  372 |           width: isActive ? CARD_W_ACTIVE : CARD_W,\n  373 |           backgroundColor: color,\n> 374 |           zIndex: effectivelyRaised ? ACTIVE_Z : total - index,\n      |                   ^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  375 |           elevation: effectivelyRaised ? 24 : total - index,\n  376 |         },\n  377 |         isActive && styles.accountCardActive,","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/almatkairatov/Desktop/code/woolet/apps/mobile-v2/src/components/accounts/wallet-bank-card.tsx:375:22\n  373 |           backgroundColor: color,\n  374 |           zIndex: effectivelyRaised ? ACTIVE_Z : total - index,\n> 375 |           elevation: effectivelyRaised ? 24 : total - index,\n      |                      ^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  376 |         },\n  377 |         isActive && styles.accountCardActive,\n  378 |       ]}",{"range":"321","text":"322"},{"range":"323","text":"324"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/almatkairatov/Desktop/code/woolet/apps/mobile-v2/src/components/transactions/transaction-edit-sheet.tsx:49:5\n  47 |   useEffect(() => {\n  48 |     if (!transaction) return;\n> 49 |     setAmount(String(transaction.amount));\n     |     ^^^^^^^^^ Avoid calling setState() directly within an effect\n  50 |     setDate(transaction.date.slice(0, 10));\n  51 |     setDescription(transaction.description ?? '');\n  52 |     setCurrencyBalanceId(transaction.currencyBalanceId);",[5394,5563],"{\n    id: string;\n    name: string;\n    type: string;\n    last4Digits?: string | null;\n    currencyBalances: Array<{ balance: string; currencyCode: string }>;\n  }[]",[5509,5557],"{ balance: string; currencyCode: string }[]",[23369,23422],"{ id: string; label: string; balance: number }[]",[7932,7992],"{ id: string; currencyCode: string; balance: string }[]",[8079,8102],"{ code: string }[]",[680,766],"{ id: string; name: string; currency: string; amount: number; isPaid: boolean }[]",[2231,2260],"(() => Promise<unknown>)[]",[7059,7097],"{ date: string; value: number }[]",{"messageId":"325","data":"326","fix":"327","desc":"328"},[980,997],"(keyof Face)[]",[3394,3421],"(Partial<Face> | null)[]","removeUnusedVar",{"varName":"329"},{"range":"330","text":"331"},"Remove unused variable \"useMemo\".","useMemo",[173,182],""]